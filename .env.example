# Copy to .env and fill in. Never commit .env.

# openai_compatible (Groq / OpenRouter / Ollama / LM Studio ...) or mock (offline regex, dev only)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Vision fallback for unreadable scans. Leave VISION_MODEL empty -> manual-review error instead.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

SPACY_MODEL=en_core_web_lg
OCR_PSM=4
OCR_MIN_ALNUM=40
OCR_MIN_CONFIDENCE=60
MAX_UPLOAD_MB=10

ALLOWED_ORIGINS=http://localhost:8501
API_URL=http://localhost:8000

TELEMETRY_LOG=./logs/telemetry.jsonl
OTEL_CONSOLE_EXPORT=1
# Optional Jaeger: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
