# Copy to .env and fill in. Never commit .env.

# openai_compatible (Gemini, Groq, OpenRouter, Ollama, LM Studio ...) or mock (offline regex, dev only)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# Vision fallback for unreadable scans. Leave VISION_MODEL empty -> manual-review error instead.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

SPACY_MODEL=en_core_web_lg
OCR_PSM=4
OCR_MIN_ALNUM=40
OCR_MIN_CONFIDENCE=60
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=5
VISION_MAX_PAGES=3

ALLOWED_ORIGINS=http://localhost:8501
API_URL=http://localhost:8000
RATE_LIMIT_PER_MINUTE=30
# A total for all clients per day, to protect the model budget on a public demo. 0 turns it off.
DAILY_EXTRACT_LIMIT=200
# Set a long random value when deployed. Protects /v1/trace/last and /v1/metrics.
INTERNAL_API_TOKEN=

# Set to 1 only on a development machine, to send webhooks to local addresses.
WEBHOOK_ALLOW_PRIVATE=0

# Sign-in, from your Clerk dashboard. Empty refuses every signed-in route. /v1/extract doesn't need it.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Background jobs. Local storage suits one machine; set s3 and S3_BUCKET when the API and workers run apart.
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=

# Required by docker compose. Use a local value with only letters and digits.
POSTGRES_PASSWORD=
# For running migrations outside Docker, for example:
# postgresql+psycopg://meridian:PASSWORD@localhost:5432/meridian
DATABASE_URL=

TELEMETRY_LOG=./logs/telemetry.jsonl
OTEL_CONSOLE_EXPORT=1
# Optional Jaeger: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
